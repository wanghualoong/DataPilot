{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DataPilot",
  "version": "0.1.0",
  "identifier": "io.github.datapilot.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DataPilot",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost; frame-src 'self' asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/datapilot-core"
    ],
    "resources": {
      "../../../Resources/": "Resources/",
      "../../../protocol/": "protocol/",
      "../../../build/vendor/python/": "python/",
      "../../../LICENSE": "Resources/about/LICENSE",
      "../../../THIRD_PARTY_NOTICES.md": "Resources/about/THIRD_PARTY_NOTICES.md"
    },
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-"
    },
    "category": "DeveloperTool"
  }
}